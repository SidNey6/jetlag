  "endgame": {
    "trigger": "Die Suchenden haben die Versteckzone betreten und sind nicht mehr in einem Verkehrsmittel.",
    "hiderMayMove": false,
    "rules": [
      "Das Endgame beginnt, sobald die Suchenden in der Versteckzone und nicht mehr in einem Verkehrsmittel sind.",
      "Der Versteckende bleibt an einem öffentlich zugänglichen Versteck, bis er gefunden wird.",
      "Ist eine Frage wegen der Bewegungseinschränkung nicht beantwortbar, ist „kann ich nicht beantworten\" gültig – es wird trotzdem gezogen."
    ]
  },
  "answering": {
    "rules": [
      "Fragen müssen wahrheitsgemäß innerhalb der Frist beantwortet werden."
